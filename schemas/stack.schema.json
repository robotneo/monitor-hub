{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotneo.github.io/monitor-hub/schemas/stack.schema.json",
  "title": "monitor-hub stack metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "support", "components", "supporting_services",
    "dependency_order", "profiles", "modes"
  ],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"enum": ["experimental", "preview", "supported"]},
        "notes": {"type": "string"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profiles"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "profiles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
          }
        }
      }
    },
    "supporting_services": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "dependency_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {"description": {"type": "string", "minLength": 1}}
      }
    },
    "modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["native", "docker", "compose", "kubernetes"]}
    }
  }
}
