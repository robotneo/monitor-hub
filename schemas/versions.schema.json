{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotneo.github.io/monitor-hub/schemas/versions.schema.json",
  "title": "monitor-hub version resolution metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_source", "repository", "tag_transform", "artifacts", "images", "compatibility"],
  "properties": {
    "release_source": {"enum": ["github", "gitlab", "static"]},
    "repository": {"type": "string", "minLength": 1},
    "tag_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strip_prefix"],
      "properties": {"strip_prefix": {"type": "string"}}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architecture", "filename"],
        "properties": {
          "os": {"enum": ["linux"]},
          "architecture": {"enum": ["amd64", "arm64"]},
          "filename": {"type": "string", "minLength": 1},
          "checksum": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repository"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1}
        }
      }
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "modes"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "modes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["native", "docker", "compose", "kubernetes"]}
          }
        }
      }
    }
  }
}
