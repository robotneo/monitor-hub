# Image variables are resolved to immutable digests by monitorctl.
# For manual Compose use, set every IMAGE variable to an exact tag or digest.
# Never use latest.
GRAFANA_PORT=3000
VICTORIAMETRICS_RETENTION=30d
VMAGENT_CONFIG_FILE=prometheus.yml
# Optional VMware collection:
# COMPOSE_PROFILES=vmware
# VMAGENT_CONFIG_FILE=prometheus-with-vmware.yml
# VMWARE_CONFIG_FILE=/etc/monitor-hub/stacks/victoriametrics-monitoring/vmware-exporter/config.yml
